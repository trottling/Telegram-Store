# TLS-терминатор + сам сервер статики панели, перед admin-backend/
# payments-backend/bot/grafana. Один хост ($DOMAIN_NAME) вместо четырёх
# поддоменов — роутинг по пути:
#   /            -> собранная SPA-панель (файлы, не отдельный сервис — см.
#                   handle "/" ниже; ничего больше не претендует на корень)
#   /api/*       -> admin-backend  (сам уже ожидает префикс /api, путь не режем)
#   /pay/*       -> payments-backend (handle_path режет /pay, дальше уходит
#                   /api/webhooks/... как есть — payments_backend его и ждёт;
#                   внешний webhook-URL получается вида .../pay/api/webhooks/crystalpay)
#   /bot, /bot/* -> bot (приём вебхуков Telegram, см. BOT_WEBHOOK_URL; путь
#                   не важен, сам хендлер его не разбирает)
#   /stats,      -> grafana (путь НЕ режем — Grafana сама объявляет свои роуты
#   /stats/*        под /stats/, см. GF_SERVER_SERVE_FROM_SUB_PATH в docker-compose.yml)
# И /bot, и /stats матчатся именованным матчером на два паттерна сразу
# ("/x" и "/x/*") — вызывающая сторона (Telegram, кнопка бота) бьёт ровно в
# голый путь без хвостового слэша, а glob "/x/*" один его не ловит (нужен
# буквальный "/" перед *); handle_path тут не подходит — его shorthand
# принимает только один путь-аргумент, потому явный path-матчер + handle.
# Один домен — один A-запись/сертификат вместо четырёх, и то, что раньше было
# кросс-origin (admin-frontend -> admin-backend), стало same-origin: CORS у
# admin_backend в проде больше не участвует (остаётся только ради
# docker-compose.debug.yml, где фронт и бэк всё ещё на разных портах), а
# сессионная cookie больше не нуждается в explicit Domain= — host-only cookie
# и так покрывает все пути одного хоста (см. admin_backend/handlers/auth_handler.go).
#
# {$VAR:default} — синтаксис дефолта у Caddy через одинарное двоеточие,
# не через ":-" как в shell/docker-compose.
#
# PUBLIC_PORT (.env, дефолт 443 — обычный случай) дописывается к адресу сайта
# всегда, безусловно: явный ":443" не проблема ни для TLS, ни для CORS (см.
# admin_backend/middleware.CORS — сравнение с нормализацией порта по
# умолчанию для схемы). Менять нужно, только если 443 на хосте занят
# посторонним сервисом (свой прокси/VPN — в отличие от admin-backend/bot,
# которые всё равно достаются caddy по имени контейнера внутри сети, caddy —
# единственный, кто реально борется за host-порт). ACME HTTP-01 всё равно
# идёт по 80, его PUBLIC_PORT не трогает.
{
	email {$ACME_EMAIL}
	# По умолчанию INFO — и тогда в лог попадает каждый обслуженный запрос
	# каждого пути. WARN (CADDY_LOG_LEVEL) оставляет то, что реально стоит
	# увидеть, тем же приёмом, что и у остального стека наблюдаемости.
	log {
		level {$CADDY_LOG_LEVEL:WARN}
	}
}

# Заголовки, общие для всех путей. Ставятся здесь, а не middleware'ом в gin:
# так они накрывают ещё и статику панели, которую отдаёт nginx, и лежат в
# одном месте вместо четырёх.
(common_headers) {
	header {
		# HSTS. Область действия — сам хост, поддоменов у нас больше нет.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Запрещает браузеру угадывать тип содержимого вопреки Content-Type.
		X-Content-Type-Options "nosniff"
		# Версию сервера наружу не сообщаем.
		-Server
	}
}

{$DOMAIN_NAME}:{$PUBLIC_PORT:443} {
	import common_headers

	# API админ-панели. Отдаёт только JSON, поэтому ресурсы ему не нужны вовсе —
	# отсюда 'none' вместо 'self'. CORS остаётся на стороне admin_backend только
	# ради docker-compose.debug.yml — здесь, за одним origin, браузер его даже
	# не спросит.
	handle /api/* {
		header {
			X-Frame-Options "DENY"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		}
		reverse_proxy admin-backend:{$ADMIN_PANEL_BACKEND_PORT:8080}
	}

	# Приём вебхуков мерчантов. Вызывающая сторона — сервер, а не браузер, так
	# что заголовки тут ни на что не влияют; выставляем их только ради
	# единообразия. handle_path режет "/pay" перед проксированием.
	handle_path /pay/* {
		reverse_proxy payments-backend:{$PAYMENTS_BACKEND_PORT:8081}
	}

	# Приём вебхуков Telegram (BOT_WEBHOOK_URL=https://$DOMAIN_NAME:$PUBLIC_PORT/bot).
	# Вызывающая сторона — сервер Telegram, не браузер; секрет проверяет сам
	# bot (X-Telegram-Bot-Api-Secret-Token, см. bot.WithWebhookSecretToken),
	# заголовки тут ни на что не влияют.
	@bot path /bot /bot/*
	handle @bot {
		reverse_proxy bot:{$BOT_WEBHOOK_PORT:8082}
	}

	# Grafana. Своей формы логина не показывает вообще — вход тем же кодом из
	# /admin, что и в панель (см. CLAUDE.md). forward_auth спрашивает
	# admin-backend "залогинен ли этот браузер" (сессионная cookie, см.
	# handlers.Exchange/middleware.Auth), копирует identity дальше в
	# X-WEBAUTH-USER, которому доверяет Grafana в режиме auth.proxy
	# (GF_AUTH_PROXY_* в docker-compose.yml).
	#
	# @denied/handle_response — иначе на отказ forward_auth молча отдаёт клиенту
	# сырое JSON-тело admin-backend (`{"code":"unauthorized",...}`), в обход
	# Caddy'шного handle_errors: это не "ошибка" в терминах Caddy, а обычный
	# проксированный ответ. Проверено вживую (docker run с :80 вместо реального
	# домена) — без этого блока незалогиненный визит на /stats получал голый
	# 401 вместо редиректа на страницу логина панели.
	#
	# Полноценный CSP сознательно не ставим — реальные требования Grafana к
	# инлайн-скриптам/стилям под саб-путём не проверены вживую (у корневого
	# пути CSP подобран эмпирически по консоли браузера). Открыть после первого
	# деплоя, проверить консоль, при необходимости дотянуть.
	#
	# frame-ancestors всё же нужен уже сейчас: /stats открывается и как
	# Telegram Mini App (см. bot/keyboards.buildAdminKb), а Telegram Web
	# встраивает Mini App через <iframe> с web.telegram.org — обычный
	# X-Frame-Options "DENY" такое встраивание запрещает наглухо. Нативные
	# мобильные клиенты и Desktop открывают Mini App как отдельный WebView,
	# не как iframe внутри своей страницы, так что этот заголовок их не
	# касается вовсе. Список origin'ов не проверялся вживую на настоящем
	# деплое — при проблеме с открытием в Telegram Web проверить консоль.
	#
	# @stats — тот же приём, что у @bot выше: кнопка "Статистика"
	# (keyboards.StatsURL) ведёт на голый "/stats" без хвостового слэша, а
	# "/stats/*" такое не матчит — без второго паттерна запрос проваливался в
	# catch-all handle{} ниже, и вместо Grafana открывалась админ-панель.
	@stats path /stats /stats/*
	handle @stats {
		header {
			Referrer-Policy "no-referrer"
			Content-Security-Policy "frame-ancestors https://web.telegram.org"
		}

		forward_auth admin-backend:{$ADMIN_PANEL_BACKEND_PORT:8080} {
			uri /api/auth/me
			# Без ">" copy_headers копирует заголовок под тем же именем —
			# admin_backend отдаёт X-Admin-Username, а Grafana в режиме
			# auth.proxy слушает GF_AUTH_PROXY_HEADER_NAME=X-WEBAUTH-USER
			# (docker-compose.yml), так что переименование обязательно.
			copy_headers {
				X-Admin-Username>X-WEBAUTH-USER
			}

			@denied status 401
			handle_response @denied {
				redir * https://{$DOMAIN_NAME}:{$PUBLIC_PORT:443}/start?to=stats
			}
		}

		reverse_proxy grafana:3000
	}

	# Панель. Всё, что не /api, /pay, /stats — сюда, включая клиентские
	# роуты SPA. Раньше здесь стоял reverse_proxy на отдельный контейнер с
	# nginx; теперь caddy отдаёт собранную статику сам — admin-frontend в
	# docker-compose.yml лишь копирует dist/ в volume и завершается
	# (root/try_files/file_server ниже — тот же SPA-фолбэк на index.html,
	# что раньше делал nginx.conf).
	handle {
		header {
			# no-referrer, а не strict-origin: в URL панели попадают telegram ID и
			# идентификаторы покупок, и утекать они не должны никуда вообще.
			Referrer-Policy "no-referrer"
			Permissions-Policy "geolocation=(), camera=(), microphone=()"

			# CSP подогнан под реальную сборку, а не скопирован из примера:
			#   style-src 'unsafe-inline' — Ant Design инжектит стили в рантайме,
			#     с чистым 'self' панель останется без оформления;
			#   connect-src 'self' — теперь то же самое, что и весь остальной
			#     сайт: API на том же origin под /api, кросс-origin allowlist
			#     (как было с api.$DOMAIN_NAME) больше не нужен вести в синхроне;
			#   data: для img/font — инлайновые иконки и шрифты Ant Design;
			#   frame-ancestors — панель открывается ещё и как Telegram Mini App
			#     (см. bot/keyboards.buildAdminKb); Telegram Web встраивает
			#     Mini App через <iframe> с web.telegram.org, обычный
			#     X-Frame-Options "DENY" такое встраивание запрещает наглухо, а
			#     frame-ancestors умеет точечно разрешить один origin вместо
			#     полного снятия защиты. Нативные мобильные клиенты и Desktop
			#     открывают Mini App как отдельный WebView, не как iframe внутри
			#     своей страницы, так что их это не касается.
			# Менять сборку фронта — перепроверять этот заголовок в консоли браузера.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors https://web.telegram.org; base-uri 'self'; form-action 'self'"
		}

		root * /srv/admin-frontend
		try_files {path} /index.html
		file_server
	}
}
