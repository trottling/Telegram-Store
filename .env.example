# Бот
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ROOT_ADMIN_ID=123456789

# База данных
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_pass
POSTGRES_NAME=shop_db
POSTGRES_SSLMODE=disable

# Redis (кэш + FSM). PASSWORD — тот же пароль включает --requirepass на
# bundled-контейнере redis из docker-compose.yml/docker-compose.debug.yml
# (пусто = без пароля, как раньше). USERNAME нужен только для ACL-пользователя
# (Redis 6+) на внешнем managed-инстансе — bundled-контейнер ACL не заводит,
# для него оставьте пустым.
REDIS_ADDR=redis:6379
REDIS_USERNAME=change_me_generate_with_openssl_rand_base64_32
REDIS_PASSWORD=change_me_generate_with_openssl_rand_base64_32
REDIS_DB=0

# Админ-панель (cmd/admin_backend): BACKEND_URL — только build-arg фронтенда
# (VITE_API_BASE_URL), в Go не читается. FRONTEND_URL — куда ведёт кнопка
# /admin (нужен реальный https:// в проде, Telegram не принимает
# localhost-ссылки). JWT_SECRET обязателен — сгенерировать через
# `openssl rand -base64 32`. Плейсхолдер ниже и любое значение короче 32
# символов отвергаются при старте: плейсхолдер лежит в git, то есть известен всем.
#
# В проде (docker-compose.yml, за caddy) BACKEND_URL и FRONTEND_URL оба
# указывают на https://$DOMAIN_NAME — один хост на всё, Caddy разводит по
# пути (/api -> admin_backend, всё остальное -> панель), см. Caddyfile.
# CORS_ORIGIN в проде из-за этого браузером не спрашивается вовсе (тот же
# origin), но остаётся нужен для docker-compose.debug.yml, где фронт (:3000) и
# бэк (:8080) — разные origin. Автоподстановки между переменными в .env нет,
# при смене домена BACKEND_URL/FRONTEND_URL и DOMAIN_NAME правятся руками
# одновременно. Локальные localhost-варианты в CORS_ORIGIN оставлены для
# docker-compose.debug.yml.
ADMIN_PANEL_BACKEND_PORT=8080
ADMIN_PANEL_BACKEND_URL=http://localhost:8080
ADMIN_PANEL_FRONTEND_URL=http://localhost:3000
ADMIN_PANEL_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ADMIN_JWT_SECRET=change_me_generate_with_openssl_rand_base64_32

# TRUSTED_PROXIES — чьему X-Forwarded-For верить (CIDR через запятую).
# Наружу admin_backend виден только через caddy, поэтому тут подсеть
# public-network из docker-compose.yml. Без этого gin доверяет заголовку от
# кого угодно, и лимит попыток входа по IP обходится одним заголовком.
ADMIN_PANEL_TRUSTED_PROXIES=172.28.0.0/16

# Приём вебхуков платежей (cmd/payments_backend): URL — внешний адрес,
# на него указывают колбэки CrystalPay/Tinkoff при создании счёта.
# В проде — https://$DOMAIN_NAME/pay (Caddy срезает "/pay" и проксирует
# дальше на payments_backend, см. Caddyfile).
PAYMENTS_BACKEND_PORT=8081
PAYMENTS_BACKEND_URL=http://localhost:8081

# TLS (docker-compose.yml, сервис caddy): один домен на всё — admin-панель,
# API, вебхуки и Grafana разведены по пути в Caddyfile (/, /api, /pay, /stats),
# а не по поддоменам, так что нужна ровно одна A-запись DNS. ACME_EMAIL —
# почта для аккаунта Let's Encrypt. docker-compose.debug.yml эти переменные
# не использует.
DOMAIN_NAME=example.com
ACME_EMAIL=admin@example.com

# Бэкапы Postgres (docker-compose.yml, сервис backup, см. backup/): ежедневный
# pg_dump в volume backup_data + опциональная выгрузка в S3 через rclone.
# S3_REMOTE/S3_BUCKET пустые — бэкап останется только локальным (в volume).
# RCLONE_CONFIG_<REMOTE>_* — remote-конфиг rclone через переменные окружения,
# имя remote'а должно совпадать с S3_REMOTE (тут "mys3" -> MYS3).
BACKUP_RETENTION_DAYS=7
S3_REMOTE=mys3
S3_BUCKET=your-bucket-name
RCLONE_CONFIG_MYS3_TYPE=s3
RCLONE_CONFIG_MYS3_PROVIDER=Other
RCLONE_CONFIG_MYS3_ENDPOINT=https://s3.yourprovider.ru
RCLONE_CONFIG_MYS3_ACCESS_KEY_ID=xxx
RCLONE_CONFIG_MYS3_SECRET_ACCESS_KEY=xxx

# Observability (Prometheus/Loki/Promtail/Grafana, docker-compose.yml).
# Вход в Grafana — не по этому логину/паролю, а тем же кодом из /admin, что
# и в веб-панель (см. CLAUDE.md, forward_auth в Caddyfile). GRAFANA_ADMIN_USER/
# PASSWORD — только break-glass доступ изнутри docker-сети, публично эта
# форма входа не показывается. *_METRICS_PORT — свой /metrics-сервер у каждого
# из трёх Go-бинарников (бот, admin_backend, payments_backend), отдельно от их
# собственных портов API/вебхуков.
BOT_METRICS_PORT=9100
ADMIN_METRICS_PORT=9101
PAYMENTS_METRICS_PORT=9102
LOKI_RETENTION_DAYS=14
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_generate_with_openssl_rand_base64_32

# Прочее
LOG_LEVEL=info
