# Бот
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ROOT_ADMIN_ID=123456789

# База данных
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_pass
POSTGRES_NAME=shop_db
POSTGRES_SSLMODE=disable

# Redis (кэш + FSM)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Админ-панель: BACKEND_URL — адрес API (VITE_API_BASE_URL фронтенда),
# FRONTEND_URL — куда ведёт кнопка /admin (нужен реальный https:// в проде,
# Telegram не принимает localhost-ссылки). JWT_SECRET обязателен —
# сгенерировать через `openssl rand -base64 32`, плейсхолдер не использовать.
ADMIN_PANEL_BACKEND_PORT=8080
ADMIN_PANEL_BACKEND_URL=http://localhost:8080
ADMIN_PANEL_FRONTEND_URL=http://localhost:3000
ADMIN_PANEL_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ADMIN_JWT_SECRET=change_me_generate_with_openssl_rand_base64_32

# Прочее
LOG_LEVEL=info
