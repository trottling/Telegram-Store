# Бот
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ROOT_ADMIN_ID=123456789
TELEGRAM_ROOT_ADMIN_USERNAME=your_username_without_@

# База данных
POSTGRES_HOST=db
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_pass
POSTGRES_NAME=shop_db
POSTGRES_SSLMODE=disable

# Redis (кэш, FSM, сессии админки) — USERNAME/PASSWORD это ACL-пользователь
# bundled-контейнера, без них не подключиться.
REDIS_ADDR=redis:6379
REDIS_USERNAME=change_me_generate_with_openssl_rand_base64_32
REDIS_PASSWORD=change_me_generate_with_openssl_rand_base64_32

# Секреты — сгенерировать: openssl rand -base64 32
ADMIN_JWT_SECRET=change_me_generate_with_openssl_rand_base64_32
BOT_WEBHOOK_SECRET=change_me_generate_with_openssl_rand_base64_32

# Домен (docker-compose.yml, сервис caddy) — одна A-запись DNS, автовыпуск
# сертификата. Наружу торчит только DOMAIN_NAME:PUBLIC_PORT — панель, API,
# вебхуки Telegram/платёжек и Grafana разведены по пути внутри caddy и сами
# подставляются из этих двух переменных, никакой из внутренних портов
# сервисов наружу не смотрит и трогать больше ничего не нужно.
#
# PUBLIC_PORT=443 — обычный случай. Поменять нужно, только если 443 на
# сервере занят чем-то посторонним (свой прокси/VPN и т.п.) — весь публичный
# трафик магазина переезжает на новый порт, caddy продолжает слушать 80
# только под ACME. (docker-compose.debug.yml не использует ни одну из этих
# трёх переменных — там нет ни домена, ни caddy.)
DOMAIN_NAME=example.com
ACME_EMAIL=admin@example.com
PUBLIC_PORT=443

# Бэкапы Postgres (backup/, необязательно): ежедневный pg_dump в volume,
# плюс S3 через rclone, если заполнены S3_REMOTE/S3_BUCKET (имя remote'а
# должно совпадать с RCLONE_CONFIG_<REMOTE>_*, тут "mys3" -> MYS3).
S3_REMOTE=
S3_BUCKET=
RCLONE_CONFIG_MYS3_TYPE=s3
RCLONE_CONFIG_MYS3_PROVIDER=Other
RCLONE_CONFIG_MYS3_ENDPOINT=
RCLONE_CONFIG_MYS3_ACCESS_KEY_ID=
RCLONE_CONFIG_MYS3_SECRET_ACCESS_KEY=

# Grafana — вход не по этому паролю (тем же кодом из /admin, что и в
# панель), это только break-glass доступ изнутри docker-сети.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_generate_with_openssl_rand_base64_32

# Уровни логов — у каждого сервиса своя переменная и свой формат значения
BOT_LOG_LEVEL=info # debug | info | warn | error | fatal | panic
ADMIN_BACKEND_LOG_LEVEL=info # debug | info | warn | error | fatal | panic
PAYMENTS_BACKEND_LOG_LEVEL=info # debug | info | warn | error | fatal | panic
MIGRATE_LOG_LEVEL=info # debug | info | warn | error | fatal | panic
ADMIN_FRONTEND_LOG_LEVEL=warn # DEBUG | INFO | WARN | ERROR
REDIS_LOG_LEVEL=warning # debug | verbose | notice | warning | nothing
POSTGRES_LOG_LEVEL=warning # debug5 .. debug1 | info | notice | warning | error | log | fatal | panic
CADDY_LOG_LEVEL=WARN # DEBUG | INFO | WARN | ERROR
GRAFANA_LOG_LEVEL=warn # debug | info | warn | error | critical
LOKI_LOG_LEVEL=warn # debug | info | warn | error
PROMETHEUS_LOG_LEVEL=warn # debug | info | warn | error
VECTOR_LOG_LEVEL=warn # debug | info | warn | error